@model P7DapperBank.Dtos.CustomerDtos.CreateCustomerDto
@{
    ViewData["Title"] = "Yeni Müşteri";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Yeni Müşteri Ekle</h1>
        <p class="page-subtitle">Sisteme yeni bir müşteri kaydı oluştur</p>
    </div>
    <a asp-action="Index" class="btn-secondary-custom"><i class="fa-solid fa-arrow-left"></i> Geri</a>
</div>

<div class="card form-page">
    <div class="card-header"><i class="fa-solid fa-user-plus"></i> Müşteri Bilgileri</div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div class="form-group">
                <label class="form-label">Ad Soyad</label>
                <input asp-for="FullName" class="form-control-custom" placeholder="Müşteri adını girin" />
            </div>
            <div class="form-actions">
                <button type="submit" class="btn-primary-custom"><i class="fa-solid fa-check"></i> Kaydet</button>
                <a asp-action="Index" class="btn-secondary-custom">İptal</a>
            </div>
        </form>
    </div>
</div>
