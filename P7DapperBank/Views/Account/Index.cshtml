@model P7DapperBank.Models.PagedResult<P7DapperBank.Dtos.AccountDtos.ResultAccountDto>
@{
    ViewData["Title"] = "Hesaplar";
    var filter = ViewBag.Filter as FilterAccountDto;
    var filters = new Dictionary<string, string?> {
        ["accountNumber"] = filter?.AccountNumber,
        ["customerId"] = filter?.CustomerId?.ToString()
    };
}

<div class="page-header">
    <div>
        <h1 class="page-title">Hesaplar</h1>
        <p class="page-subtitle record-count">Toplam <strong>@Model.TotalCount.ToString("N0")</strong> kayıt</p>
    </div>
    <a asp-action="Create" class="btn-primary-custom"><i class="fa-solid fa-plus"></i> Yeni Hesap</a>
</div>

<div class="filter-bar">
    <form method="get">
        <div class="filter-field">
            <label class="filter-label">Hesap No</label>
            <input class="filter-input" type="text" name="accountNumber" value="@filter?.AccountNumber" placeholder="Hesap no ara..." />
        </div>
        <div class="filter-field">
            <label class="filter-label">Müşteri ID</label>
            <input class="filter-input" type="number" name="customerId" value="@filter?.CustomerId" placeholder="Müşteri ID..." />
        </div>
        <div class="filter-actions">
            <button type="submit" class="btn-primary-custom"><i class="fa-solid fa-magnifying-glass"></i> Filtrele</button>
            <a asp-action="Index" class="btn-secondary-custom"><i class="fa-solid fa-xmark"></i> Temizle</a>
        </div>
    </form>
</div>

<div class="card">
    <div class="table-wrapper">
        <table class="data-table">
            <thead>
                <tr><th>Hesap Numarası</th><th>Müşteri ID</th><th style="width:120px">İşlemler</th></tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="3"><div class="empty-state"><i class="fa-solid fa-credit-card"></i>Kayıt bulunamadı</div></td></tr>
                }
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td style="font-family:monospace;font-size:13px;font-weight:600">@item.AccountNumber</td>
                        <td><span style="color:var(--accent)">#@item.CustomerId</span></td>
                        <td>
                            <div class="action-cell">
                                <a asp-action="Update" asp-route-accountNumber="@item.AccountNumber" class="btn-edit-custom">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                                <form asp-action="Delete" method="post" onsubmit="return confirm('Silmek istediğinizden emin misiniz?')">
                                    <input type="hidden" name="accountNumber" value="@item.AccountNumber" />
                                    <button type="submit" class="btn-danger-custom"><i class="fa-solid fa-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@await Component.InvokeAsync("Pagination", new { currentPage = Model.Page, totalPages = Model.TotalPages, controllerName = "Account", actionName = "Index", filters = filters })
