@model P7DapperBank.Dtos.AccountDtos.CreateAccountDto
@{
    ViewData["Title"] = "Yeni Hesap";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Yeni Hesap Ekle</h1>
        <p class="page-subtitle">Müşteriye ait yeni bir banka hesabı oluştur</p>
    </div>
    <a asp-action="Index" class="btn-secondary-custom"><i class="fa-solid fa-arrow-left"></i> Geri</a>
</div>

<div class="card form-page">
    <div class="card-header"><i class="fa-solid fa-credit-card"></i> Hesap Bilgileri</div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div class="form-group">
                <label class="form-label">Hesap Numarası</label>
                <input asp-for="AccountNumber" class="form-control-custom" placeholder="TR..." />
            </div>
            <div class="form-group">
                <label class="form-label">Müşteri ID</label>
                <input asp-for="CustomerId" type="number" class="form-control-custom" placeholder="Müşteri ID girin" />
            </div>
            <div class="form-actions">
                <button type="submit" class="btn-primary-custom"><i class="fa-solid fa-check"></i> Kaydet</button>
                <a asp-action="Index" class="btn-secondary-custom">İptal</a>
            </div>
        </form>
    </div>
</div>
