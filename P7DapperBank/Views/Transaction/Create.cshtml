@model P7DapperBank.Dtos.TransactionDtos.CreateTransactionDto
@{
    ViewData["Title"] = "Yeni İşlem";
    var types = ViewBag.TransactionTypes as List<P7DapperBank.Dtos.TransactionTypeDtos.ResultTransactionTypeDto>;
}

<div class="page-header">
    <div>
        <h1 class="page-title">Yeni İşlem Ekle</h1>
        <p class="page-subtitle">Sisteme yeni bir banka işlemi kaydet</p>
    </div>
    <a asp-action="Index" class="btn-secondary-custom"><i class="fa-solid fa-arrow-left"></i> Geri</a>
</div>

<div class="card" style="max-width:820px">
    <div class="card-header"><i class="fa-solid fa-arrow-right-arrow-left"></i> İşlem Bilgileri</div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:0 24px">
                <div class="form-group">
                    <label class="form-label">Hesap Numarası</label>
                    <input asp-for="AccountNumber" class="form-control-custom" placeholder="TR..." />
                </div>
                <div class="form-group">
                    <label class="form-label">İşlem Tarihi</label>
                    <input asp-for="TransactionDate" type="datetime-local" class="form-control-custom" />
                </div>
                <div class="form-group">
                    <label class="form-label">Tutar (₺)</label>
                    <input asp-for="Amount" type="number" step="0.01" class="form-control-custom" placeholder="0.00" />
                </div>
                <div class="form-group">
                    <label class="form-label">İşlem Tipi</label>
                    <select asp-for="TypeId" class="form-select-custom">
                        @if (types != null)
                        {
                            @foreach (var t in types)
                            {
                                <option value="@t.TypeId">@t.TypeName</option>
                            }
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Durum</label>
                    <select asp-for="Status" class="form-select-custom">
                        <option value="SUCCESS">SUCCESS</option>
                        <option value="PENDING">PENDING</option>
                        <option value="FAILED">FAILED</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Para Birimi</label>
                    <select asp-for="Currency" class="form-select-custom">
                        <option>TRY</option><option>USD</option><option>EUR</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Gönderen Banka ID</label>
                    <input asp-for="SenderBankId" type="number" class="form-control-custom" />
                </div>
                <div class="form-group">
                    <label class="form-label">Alıcı Banka ID</label>
                    <input asp-for="ReceiverBankId" type="number" class="form-control-custom" />
                </div>
                <div class="form-group">
                    <label class="form-label">İşlem Sonrası Bakiye</label>
                    <input asp-for="BalanceAfter" type="number" step="0.01" class="form-control-custom" placeholder="0.00" />
                </div>
                <div class="form-group">
                    <label class="form-label">Açıklama</label>
                    <input asp-for="Description" class="form-control-custom" placeholder="İşlem açıklaması" />
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn-primary-custom"><i class="fa-solid fa-check"></i> Kaydet</button>
                <a asp-action="Index" class="btn-secondary-custom">İptal</a>
            </div>
        </form>
    </div>
</div>
